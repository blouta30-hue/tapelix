# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE (Base de données et Storage communs Site Principal + Site Admin)
# ============================================================================
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
# Clé secrète côté serveur uniquement (NE JAMAIS exposer dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY="VOTRE_SUPABASE_SERVICE_ROLE_KEY"

# ============================================================================
# SÉCURITÉ API ADMIN (https://tapelix-adm.ai.studio/)
# ============================================================================
# Clé secrète partagée uniquement entre server.ts et le backend/session Admin
ADMIN_API_KEY="GENEREZ_UNE_CLE_SECRETE_LONGUE_ICI"
ADMIN_ORIGIN="https://tapelix-adm.ai.studio"

# ============================================================================
# WHATSAPP BUSINESS CLOUD API (Notification automatique au +213 782 308 820)
# ============================================================================
WHATSAPP_ACCESS_TOKEN="VOTRE_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="VOTRE_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_TEMPLATE_NAME="tapelix_new_order"
WHATSAPP_LANGUAGE_CODE="fr"
WHATSAPP_OWNER_PHONE="213782308820"
